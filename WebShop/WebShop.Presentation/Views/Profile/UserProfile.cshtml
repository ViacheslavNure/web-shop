@using WebShop.Core.Models.Order
@model WebShop.Core.Models.User.UserProfileViewModel

@{
    string MapOrderDeliveryMethod(DeliveryMethod deliveryMethod) => deliveryMethod switch
    {
        DeliveryMethod.NovaPoshta => "Нова Пошта",
        DeliveryMethod.UkrPoshta => "УкрПошта",
        DeliveryMethod.SelfPickup => "Самовивіз",
        _ => "Невідомий метод"
    };

    var phoneNumber = $"+38{Model.PhoneNumber}";

    ViewData["ShowBackButton"] = true;
    ViewData["BackButtonData"] = ("Products", "GridView");
}

<div class="container py-5" style="margin-top: 50px;">
    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body text-center">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava3.webp"
                         alt="avatar" class="rounded-circle img-fluid" style="width: 150px;">
                    <h5 class="my-3">@Model.UserName</h5>
                    <p class="text-muted mb-1">@Model.Email</p>
                    <p class="text-muted mb-4">@phoneNumber</p>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            <p class="mb-0"><strong>Кількість замовлень:</strong></p>
                            <p class="text-muted mb-0">@Model.OrdersCount</p>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-sm-12">
                            <p class="mb-0"><strong>Загальна сума замовлень:</strong></p>
                            <p class="text-muted mb-0">@Model.TotalOrdersPrice грн.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-4">Мої замовлення</h5>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">Номер</th>
                                        <th scope="col">Дата</th>
                                        <th scope="col">Адреса</th>
                                        <th scope="col">Метод доставки</th>
                                        <th scope="col">Сума</th>
                                        <th scope="col">Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr class="order-row" style="cursor: pointer;" data-order-number="@order.OrderNumber">
                                            <td>@order.OrderNumber</td>
                                            <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                                            <td>@order.DeliveryAddress</td>
                                            <td>@MapOrderDeliveryMethod(order.DeliveryMethod)</td>
                                            <td>@order.TotalPrice.ToString("C2")</td>
                                            <td><span class="badge bg-success">@order.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">У вас ще немає замовлень.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="orderDetailsContent">
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table th {
            font-weight: 600;
        }

        .badge {
            padding: 0.5em 1em;
            font-weight: 500;
        }

        .order-row:hover {
            background-color: rgba(0, 0, 0, 0.05);
            transition: background-color 0.2s ease;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.order-row').click(function() {
                const orderNumber = $(this).data('order-number');
                
                $('#orderDetailsContent').html('<div class="text-center p-5"><div class="spinner-border" role="status"><span class="visually-hidden">Завантаження...</span></div></div>');
                $('#orderDetailsModal').modal('show');

                $.get('/Orders/GetOrderDetails', { orderNumber: orderNumber })
                    .done(function(response) {
                        $('#orderDetailsContent').html(response);
                    })
                    .fail(function() {
                        $('#orderDetailsContent').html('<div class="modal-content"><div class="modal-body"><div class="alert alert-danger">Помилка при завантаженні деталей замовлення</div></div></div>');
                    });
            });
        });
    </script>
} 