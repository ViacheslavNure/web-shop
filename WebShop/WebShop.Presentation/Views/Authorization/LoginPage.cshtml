@using WebShop.Core.Models.Authorization
@model UserLoginCredentialsViewModel
@{
    ViewBag.Title = "Реєстрація";
}

<div style="margin-top: 100px;">
    <div class="mb-3">
        <h2 style="text-align: center;">Увійдіть в акаунт</h2>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <form asp-controller="Authorization" asp-action="LoginUser" method="post">
                    <div class="form-group mb-3">
                        <input asp-for="UserName" type="text" class="form-control" id="Username" name="Username" placeholder="Ім'я користувача" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="Password" name="Password" placeholder="Пароль" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-dark btn-block w-100 mb-3">Увійти</button>
                </form>
                <form asp-controller="Authorization" asp-action="SignupPage" method="get">
                    <button type="submit" class="btn btn-light btn-block w-100">Зареєструватися</button>
                </form>
            </div>
        </div>
    </div>
</div>