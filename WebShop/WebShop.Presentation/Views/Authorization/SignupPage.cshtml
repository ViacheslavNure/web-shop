@using WebShop.Core.Models.Authorization
@model UserSignupCredentialsViewModel
@{
    ViewBag.Title = "Реєстрація";

    ViewData["ShowBackButton"] = true;
    ViewData["BackButtonData"] = ("Authorization", "LoginPage");
}

<div style="margin-top: 100px;">
    <div class="mb-3">
        <h2 style="text-align: center;">Створіть акаунт</h2>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div asp-validation-summary="All" class="text-danger"></div>

                <form asp-controller="Authorization" asp-action="SignupUser" method="post">
                    <div class="form-group mb-3">
                        <input asp-for="UserName" type="text" class="form-control" id="Username" name="Username" placeholder="Ім'я користувача" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="Password" name="Password" placeholder="Пароль" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input asp-for="PasswordConfirmation" type="password" class="form-control" id="PasswordConfirmation" name="PasswordConfirmation" placeholder="Підтвердження паролю" />
                        <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input asp-for="Email" type="text" class="form-control" id="Email" name="Email" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input asp-for="PhoneNumber" type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" placeholder="Номер телефону" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-dark btn-block w-100">Зареєструватись</button>
                </form>
            </div>
        </div>
    </div>
</div>