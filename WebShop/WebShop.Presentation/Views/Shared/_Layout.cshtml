@using WebShop.Core.Models.UIElements
@{
    var showNavbar = (bool?)ViewData["ShowNavbar"] ?? false;
    var showSideBar = (bool?)ViewData["ShowSideBar"] ?? false;
    var navBarItems = (IEnumerable<NavBarItemViewModel>?)ViewData["ProductCategories"] ?? [];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebShop.Presentation</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebShop.Presentation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @if (showNavbar)
        {
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
                <div class="container-fluid p-2">
                    @if(navBarItems.Any())
                    {
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                @foreach (var item in navBarItems)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark"
                                           asp-controller="@item.RedirectToController"
                                           asp-action="@item.RedirectToAction"
                                           asp-route-selectedProductsCategoryId="@item.Id">@item.Name</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="d-flex justify-content-end w-100">
                        <a asp-controller="Products" asp-action="CreateProductPage" class="btn btn-secondary me-2" style="color: white;"><i class="fa fa-plus"></i> Create product</a>
                        <a class="btn btn-secondary me-2" style="color: white;"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
                        <a class="btn btn-secondary" style="color: white;"><i class="fa-solid fa-user"></i> My profile</a>
                    </div>
                </div>
            </nav>
        }
    </header>

    @if (showSideBar)
    {
        <div class="container-fluid">
            <div>
                <div class="sidebar">
                    @RenderSection("Sidebar", required: false)
                </div>
            </div>
            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
