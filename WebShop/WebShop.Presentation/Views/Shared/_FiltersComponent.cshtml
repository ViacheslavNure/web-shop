@model ProductGridFilterViewModel

<div class="m-3 bg-light-subtle">
    <form asp-controller="Products" asp-action="FilterGridView" method="post">
        <div>
            <h4 class="text-center">Price</h4>
        </div>
        <div class="form-group">
            From
            <input type="number" class="form-control" asp-for="MinPrice" />
        </div>
        <div>
            To
            <input type="number" class="form-control" asp-for="MaxPrice" />
        </div>

        <hr class="hr" />

        <div>
            <h4 class="text-center">Brands</h4>
        </div>
        <div class="form-group">
            @foreach (var brand in ViewData["Brands"] as List<string> ?? [])
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="Brands" value="@brand"
                    @(Model.Brands?.Contains(brand) ?? false ? "checked" : "") />
                    <label class="form-check-label">@brand</label>
                </div>
            }
        </div>

        <hr class="hr" />

        <button class="form-control btn btn-dark">Apply filter</button>
    </form>

    <form asp-controller="Products" asp-action="ClearFilters" method="post">
        <button type="submit" class="form-control btn btn-light">Clear</button>
    </form>
</div>
