@using WebShop.Core.Models.Order
@model WebShop.Core.Models.Order.OrderViewModel

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Замовлення №@Model.PublicOrderNumber</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="mb-3">Інформація про доставку</h6>
                <p><strong>Метод доставки:</strong> @(Model.DeliveryMethod == DeliveryMethod.NovaPoshta ? "Нова Пошта" : 
                                                     Model.DeliveryMethod == DeliveryMethod.UkrPoshta ? "УкрПошта" : "Самовивіз")</p>
                <p><strong>Адреса:</strong> @Model.DeliveryAddress</p>
                <p><strong>Місто:</strong> @Model.City</p>
                <p><strong>Поштовий індекс:</strong> @Model.PostalCode</p>
            </div>
            <div class="col-md-6">
                <h6 class="mb-3">Інформація про оплату</h6>
                <p><strong>Номер карти:</strong> **** **** **** @Model.CardNumber.Substring(Math.Max(0, Model.CardNumber.Length - 4))</p>
                <p><strong>Термін дії:</strong> @Model.CardExpiry</p>
            </div>
        </div>

        <h6 class="mb-3">Товари</h6>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Зображення</th>
                        <th>Бренд</th>
                        <th>Модель</th>
                        <th>Кількість</th>
                        <th>Ціна</th>
                        <th>Сума</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <img src='@($"\\{item.ImagePath}")' alt="@item.Model" class="img-thumbnail" style="max-width: 50px;">
                            </td>
                            <td>@item.Brand</td>
                            <td>@item.Model</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price грн.</td>
                            <td>@(item.Price * item.Quantity) грн.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end"><strong>Загальна сума:</strong></td>
                        <td><strong>@Model.TotalPrice грн.</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(Model.OrderComments))
        {
            <div class="mt-4">
                <h6 class="mb-3">Коментар до замовлення</h6>
                <p class="mb-0">@Model.OrderComments</p>
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрити</button>
    </div>
</div> 