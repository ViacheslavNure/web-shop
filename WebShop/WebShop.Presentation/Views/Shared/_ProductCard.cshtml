@using WebShop.Presentation.Models
@model ProductCardViewModel

<div class='card p-3 card-custom'>
    <img class='card-img' src='@Model.ImagePath' alt='@Model.Brand @Model.Model'>
    <div class='card-body'>
        <div class='row'>
            <div class='col-6'>
                <h5 class='card-title'>@Model.Brand</h5>
                <p class='card-text'>
                    @Model.Model
                    <br />
                    Price: @Model.Price$
                </p>
            </div>
            <div class='col-6 d-flex flex-column justify-content-end'>
                <div class='d-flex justify-content-end mb-3 align-middle'>
                    <span class='small'>@Model.LikesCount</span>
                    <button class='like-button' onclick="onLikeButtonClick(event,'@Model.Id')">
                        <span class='text-danger' style='font-size: 1.5rem;'>
                            <i class='fas fa-heart'></i>
                        </span>
                    </button>
                </div>
                <div class='d-flex justify-content-end'>
                    <button class='btn btn-primary buy-button'>Купить</button>
                </div>
            </div>
        </div>
    </div>
</div>
