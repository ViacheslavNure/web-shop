@model long

@{
    ViewData["ShowBackButton"] = true;
    ViewData["BackButtonData"] = ("Products", "GridView");
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-success.css" />
}

<div class="container" style="margin-top: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="success-checkmark">
                <div class="check-icon">
                    <span class="icon-line line-tip"></span>
                    <span class="icon-line line-long"></span>
                    <div class="icon-circle"></div>
                    <div class="icon-fix"></div>
                </div>
            </div>
            
            <h2 class="mb-4">Замовлення успішно створено!</h2>
            
            <div class="order-details p-4 mb-4 bg-light rounded">
                <p class="mb-2">Номер вашого замовлення:</p>
                <h3 class="text-dark mb-0">#@Model</h3>
            </div>
            
            <p class="text-muted mb-4">
                Дякуємо за ваше замовлення! Ми надішлемо вам електронного листа з підтвердженням та деталями замовлення.
            </p>
            
            <a asp-controller="Products" asp-action="GridView" class="btn btn-dark btn-lg">
                Повернутися до магазину
            </a>
        </div>
    </div>
</div>