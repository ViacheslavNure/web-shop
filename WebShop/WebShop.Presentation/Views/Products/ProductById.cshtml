@using WebShop.Core.Models.Product
@model ProductDetailsViewModel

@{
    ViewData["ShowBackButton"] = true;
    ViewData["BackButtonData"] = ("Products", "GridView");

    var features = Model.CategorizedFeatures; 
}

<div class="container product-details" style="margin-top: 100px;">
    <div class="row">
        <div class="col-md-6">
            <div class="product-image-container">
                <img class="product-image img-fluid" src='@($"\\{Model.ImagePath}")' alt='@Model.Brand @Model.Model' />
            </div>
        </div>
        <div class="col-md-6">
            <div class="product-info">
                <h1 class="product-title">@Model.Brand @Model.Model</h1>
                <div class="price-section">
                    <h2 class="product-price">@Model.Price грн</h2>
                </div>
                <a class="btn btn-dark btn-lg w-100 add-to-cart-btn buy-button" data-product-id="@Model.Id">
                    <i class="bi bi-bag-fill me-2"></i>
                    Додати в кошик
                </a>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="description-section">
                <h3 class="section-title">Опис товару</h3>
                <p class="description-text">@Model.Description</p>
            </div>
        </div>
    </div>

    @if(Model.CategorizedFeatures.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="features-section">
                    <h3 class="section-title">Характеристики</h3>
                    <div class="features-list">
                        @foreach (var featureCategory in Model.CategorizedFeatures)
                        {
                            <div class="feature-category">
                                <h4 class="category-name">@featureCategory.Name</h4>
                                <div class="feature-items">
                                    @foreach (var feature in featureCategory.Features)
                                    {
                                        <div class="feature-item">
                                            <span class="feature-name">@feature.Name</span>
                                            <span class="feature-value">@feature.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>